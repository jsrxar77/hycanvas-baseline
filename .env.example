# ==============================================================================
# HyCanvas Baseline - Plantilla de Variables de Entorno
# Subdominio Oficial: hycanvas.holospace.com.ar
# ==============================================================================

# Puerto host expuesto (enlace Nginx o acceso directo)
APP_PORT=8088

# Secretos de Seguridad (Generar con: openssl rand -hex 32)
JWT_SECRET=""
AI_SECRET=""

# URL publica oficial
APP_URL="https://hycanvas.holospace.com.ar"
FRONTEND_URL="https://hycanvas.holospace.com.ar"

# Base de datos PostgreSQL propia para HyCanvas (Aislada en red Docker interna)
POSTGRES_USER="hycanvas_user"
POSTGRES_PASSWORD="change_me_secure_password"
POSTGRES_DB="hycanvas_db"
DATABASE_URL="postgresql://hycanvas_user:change_me_secure_password@hycanvas_db:5432/hycanvas_db?schema=public"

# Configuracion de Entorno
NODE_ENV="production"
PORT="8005"
DB_AUTO_MIGRATE="true"
DB_CONNECT_ATTEMPTS="20"
DB_CONNECT_RETRY_DELAY="5s"

# Al estar detras de Nginx con SSL en produccion, se activa COOKIE_SECURE
COOKIE_SECURE="true"

# Almacenamiento local persistente
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="/app/.data/storage"

# Redis deshabilitado para despliegue monolitico eficiente
REDIS_URL=""
